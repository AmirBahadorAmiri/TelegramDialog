<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="false">

    <translate
        android:fromXDelta="0"
        android:toXDelta="25dp"
        android:duration="80"
        android:interpolator="@android:anim/bounce_interpolator" />

    <translate
        android:fromXDelta="25dp"
        android:toXDelta="-20dp"
        android:startOffset="80"
        android:duration="80"
        android:interpolator="@android:anim/bounce_interpolator" />

    <translate
        android:fromXDelta="-20dp"
        android:toXDelta="15dp"
        android:startOffset="160"
        android:duration="80"
        android:interpolator="@android:anim/bounce_interpolator" />

    <translate
        android:fromXDelta="15dp"
        android:toXDelta="-10dp"
        android:startOffset="240"
        android:duration="80"
        android:interpolator="@android:anim/bounce_interpolator" />

    <translate
        android:fromXDelta="-10dp"
        android:toXDelta="0"
        android:startOffset="320"
        android:duration="100"
        android:interpolator="@android:anim/decelerate_interpolator" />

</set>